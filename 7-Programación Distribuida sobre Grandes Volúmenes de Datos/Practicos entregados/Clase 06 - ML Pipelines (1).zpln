e":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h3>Ejercicio</h3>\n<p>Hacer con pipelines uno de los ejemplos de clasificación de la clase anterior. Plotear el resultado.</p>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757723340577_376126123","id":"20191205-195354_363578557","dateCreated":"2025-09-12T21:29:00-0300","dateStarted":"2025-10-03T17:04:46-0300","dateFinished":"2025-10-03T17:04:46-0300","status":"FINISHED"},{"text":"%md\n\n#### Funciones de ayuda del TP anterior","user":"admin","dateUpdated":"2025-10-03T17:04:46-0300","progress":0,"config":{"lineNumbers":true,"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/markdown","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h4>Funciones de ayuda del TP anterior</h4>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1759184075278_1693831652","id":"paragraph_1759184075278_1693831652","dateCreated":"2025-09-29T19:14:35-0300","dateStarted":"2025-10-03T17:04:46-0300","dateFinished":"2025-10-03T17:04:46-0300","status":"FINISHED"},{"text":"%pyspark\n\nimport matplotlib.pyplot as plt\nimport numpy as np\nimport matplotlib.cm as cm\n\nfrom matplotlib.colors import ListedColormap, LinearSegmentedColormap\nfrom pyspark.sql.functions import col, min, max\nfrom pyspark.sql.dataframe import DataFrame\nfrom pyspark.ml.functions import vector_to_array\n\n\ndef createGrid(df: DataFrame) -> DataFrame:\n    maxTics = 256\n\n    def fgrid (x, min, max):\n        mtics1 = maxTics - 1\n        return (float(x)*(max-min)+mtics1*min)/mtics1\n\n    minKgs, maxKgs, minMts, maxMts = df \\\n        .agg(min(\"kgs\"), max(\"kgs\"), min(\"mts\"), max(\"mts\")) \\\n        .first()\n\n    # 1.- numeracion ticks en x\n    # 2.- numeracion ticks en (x, y)\n    # 3.- todos los (kgs, mts)\n    return sc.parallelize(range(maxTics)) \\\n        .flatMap(lambda x: [ (x, y) for y in range(maxTics)]) \\\n        .map(lambda x_y: (fgrid(x_y[0], minKgs, maxKgs), fgrid(x_y[1], minMts, maxMts))) \\\n        .toDF([\"kgs\", \"mts\"])\n\n\ndef plot_classification(df: DataFrame, surfaceDF: DataFrame = None, prob: bool = False, posM: int = 0) -> None:\n    cmap_light = LinearSegmentedColormap.from_list(\"light\", ['#FF5555', '#5555FF'])\n    cmap_pastel = LinearSegmentedColormap.from_list(\"pastel\", ['#FF8888', '#8888FF'])\n    cmap_bold = ListedColormap(['#FF0000', '#00FF00', '#0000FF'])\n\n    # helper function to display in Zeppelin\n    def show(p):\n        from io import BytesIO\n        import base64\n        img = BytesIO()\n        p.savefig(img, format='png')#,dpi=600)\n        img.seek(0)\n        print(\"%html <div style='width:600px'><img src=\\\"data:image/png;base64,\" + base64.encodebytes(img.getvalue()).decode().replace('\\n', '') + \"\\\"/></div>\")\n\n    plt.close('all')\n\n    plt.autoscale(enable=True, axis='x', tight=True)\n\n    if surfaceDF:\n        if prob:\n            pSTable = surfaceDF.select('kgs','mts').toPandas()\n            probDF = surfaceDF.select(vector_to_array(col('probability'))[1-posM].alias('prob'))\n            Z = probDF.toPandas()['prob']\n        else:\n            pSTable = surfaceDF.select('kgs','mts','prediction').toPandas()\n            Z = pSTable['prediction']\n\n        xs = pSTable['kgs']\n        ys = pSTable['mts']\n\n        xUs = xs.unique()\n        yUs = ys.unique()\n\n        xx, yy = np.meshgrid(xUs,yUs)\n\n        Z = Z.values.reshape(xx.shape).transpose()\n\n        if prob:\n            plt.pcolormesh(xx, yy, Z, shading='auto', cmap=cmap_light)\n        else:\n            plt.pcolormesh(xx, yy, Z, shading='auto', cmap=cmap_pastel)\n\n        plt.axis([xs.min(), xs.max(), ys.min(), ys.max()])\n\n    pTable = df.select('kgs','mts','label').toPandas().sample(frac=1)\n\n    xs = pTable['kgs']\n    ys = pTable['mts']\n    cs = pTable['label']\n    plt.scatter(xs, ys, c=cs, cmap=cmap_bold, alpha=0.5, s=16)\n    plt.xlabel('kgs')\n    plt.ylabel('mts')\n\n    show(plt)\n    plt.close()\n","user":"admin","dateUpdated":"2025-10-03T17:04:47-0300","progress":0,"config":{"lineNumbers":true,"tableHide":false,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"colWidth":12,"editorMode":"ace/mode/python","fontSize":9,"editorHide":false,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1759184064192_352495070","id":"paragraph_1759184064192_352495070","dateCreated":"2025-09-29T19:14:24-0300","dateStarted":"2025-10-03T17:04:47-0300","dateFinished":"2025-10-03T17:04:47-0300","status":"FINISHED"},{"text":"%md\n\n#### Implementación de clasificación mediante una _pipeline_","user":"admin","dateUpdated":"2025-10-03T17:04:47-0300","progress":0,"config":{"lineNumbers":true,"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/markdown","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h4>Implementación de clasificación mediante una <em>pipeline</em></h4>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1759184310155_90516452","id":"paragraph_1759184310155_90516452","dateCreated":"2025-09-29T19:18:30-0300","dateStarted":"2025-10-03T17:04:47-0300","dateFinished":"2025-10-03T17:04:47-0300","status":"FINISHED"},{"text":"%pyspark\n\nfrom pyspark.ml.classification import DecisionTreeClassifier, LinearSVC, RandomForestClassifier\nfrom pyspark.ml.feature import StringIndexer, VectorAssembler\nfrom pyspark.ml import Pipeline\n\ninputFile = \"../../diplodatos_bigdata/ds/people_sex_height_age_weight.json\"\n\npeople = spark.read.json(inputFile) \\\n    .select(\"kgs\", \"mts\", \"sex\") \\\n    .repartition(sc.defaultParallelism) \\\n    .cache()\n\n# Separamos de la misma forma que en el TP anterior para poder comparar resultados\ntrainDF, testDF = people.randomSplit([0.95, 0.05], seed=2345)\n\nvAssembler = VectorAssembler(\n    inputCols = [\"kgs\", \"mts\"],\n    outputCol = \"features\")\n\nstrIndexer = StringIndexer(\n    inputCol = \"sex\",\n    outputCol = \"label\",\n    stringOrderType = \"alphabetDesc\")\n\n# Algunos estimadores del TP5 para probar (descomentar el elegido)\n#estimator = LinearSVC(maxIter=10, labelCol=\"label\", regParam=0.1)\n#estimator = DecisionTreeClassifier(featuresCol=\"features\", labelCol=\"label\", maxDepth = 10)\n#estimator = LogisticRegression(maxIter=100, labelCol=\"label\", regParam=0.01)\nestimator = RandomForestClassifier(featuresCol=\"features\", labelCol=\"label\", numTrees=200)\n\ntrain_pipeline = Pipeline(stages=[vAssembler, strIndexer, estimator])\ntrain_model = train_pipeline.fit(trainDF)\n\ngrid_df = createGrid(people)\ngrid_prediction_dt = train_model.transform(grid_df)\n\ntest_pipeline = Pipeline(stages=[vAssembler, strIndexer])\ntest_model = test_pipeline.fit(trainDF)\ntest_featurized_dt = test_model.transform(testDF)\n\nif isinstance(estimator, LogisticRegression):\n    posM = test_model.stages[1].labels.index(\"M\")\n    plot_classification(test_featurized_dt, surfaceDF=grid_prediction_dt, prob=True, posM=posM)\nelse:\n    plot_classification(test_featurized_dt, surfaceDF=grid_prediction_dt)","user":"admin","dateUpdated":"2025-10-03T17:04:47-0300","progress":0,"config":{"lineNumbers":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"colWidth":12,"editorMode":"ace/mode/python","fontSize":9,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div style='width:600px'><img src=\"data:image/png;base64,\"/></div>\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.2.161:4040/jobs/job?id=322"},{"jobUrl":"http://192.168.2.161:4040/jobs/job?id=323"},{"jobUrl":"http://192.168.2.161:4040/jobs/job?id=324"},{"jobUrl":"http://192.168.2.161:4040/jobs/job?id=325"},{"jobUrl":"http://192.168.2.161:4040/jobs/job?id=326"},{"jobUrl":"http://192.168.2.161:4040/jobs/job?id=327"},{"jobUrl":"http://192.168.2.161:4040/jobs/job?id=328"},{"jobUrl":"http://192.168.2.161:4040/jobs/job?id=329"},{"jobUrl":"http://192.168.2.161:4040/jobs/job?id=330"},{"jobUrl":"http://192.168.2.161:4040/jobs/job?id=331"},{"jobUrl":"http://192.168.2.161:4040/jobs/job?id=332"},{"jobUrl":"http://192.168.2.161:4040/jobs/job?id=333"},{"jobUrl":"http://192.168.2.161:4040/jobs/job?id=334"},{"jobUrl":"http://192.168.2.161:4040/jobs/job?id=335"},{"jobUrl":"http://192.168.2.161:4040/jobs/job?id=336"},{"jobUrl":"http://192.168.2.161:4040/jobs/job?id=337"},{"jobUrl":"http://192.168.2.161:4040/jobs/job?id=338"},{"jobUrl":"http://192.168.2.161:4040/jobs/job?id=339"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1759181747252_1153263436","id":"paragraph_1759181747252_1153263436","dateCreated":"2025-09-29T18:35:47-0300","dateStarted":"2025-10-03T17:04:47-0300","dateFinished":"2025-10-03T17:04:56-0300","status":"FINISHED"},{"text":"%pyspark\n","user":"admin","dateUpdated":"2025-10-03T17:04:56-0300","progress":0,"config":{"lineNumbers":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"colWidth":12,"editorMode":"ace/mode/python","fontSize":9,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1759181480244_93493969","id":"paragraph_1759181480244_93493969","dateCreated":"2025-09-29T18:31:20-0300","dateStarted":"2025-10-03T17:04:56-0300","dateFinished":"2025-10-03T17:04:56-0300","status":"FINISHED"},{"title":"Fin","text":"val baseDir=\"https://bitbucket.org/bigdata_famaf/diplodatos_bigdata/raw/HEAD/clases\"\n//val baseDir=\"https://git.cs.famaf.unc.edu.ar/dbarsotti/diplodatos_bigdata/raw/master/clases\"\n\nz.put(\"baseDir\", baseDir)\nprint(\"\"\"%html\n<script>\n    var heads = document.getElementsByTagName('h2');\n    var numHeads = heads.length;\n    var inner = \"\";\n    var i = 0;\n    var j = 0;\n    while (i < numHeads){\n        inner = heads[i].innerHTML;\n        if (inner.search(\".-\") != -1 ) {\n            j++;\n            heads[i].innerHTML = inner.replace(/(~|\\d+)\\.-/,\"\"+j+\".-\");\n        }\n        i++\n    }\n</script>\n\"\"\")","user":"admin","dateUpdated":"2025-10-03T17:04:56-0300","progress":0,"config":{"lineNumbers":true,"tableHide":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"colWidth":12,"editorMode":"ace/mode/scala","editorHide":true,"fontSize":9,"title":true,"results":[{"graph":{"mode":"table","height":300,"optionOpen":false,"keys":[],"values":[],"groups":[],"scatter":{}}}],"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<script>\n    var heads = document.getElementsByTagName('h2');\n    var numHeads = heads.length;\n    var inner = \"\";\n    var i = 0;\n    var j = 0;\n    while (i < numHeads){\n        inner = heads[i].innerHTML;\n        if (inner.search(\".-\") != -1 ) {\n            j++;\n            heads[i].innerHTML = inner.replace(/(~|\\d+)\\.-/,\"\"+j+\".-\");\n        }\n        i++\n    }\n</script>\n\u001b[1m\u001b[34mbaseDir\u001b[0m: \u001b[1m\u001b[32mString\u001b[0m = https://bitbucket.org/bigdata_famaf/diplodatos_bigdata/raw/HEAD/clases\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757723340596_638426018","id":"20161027-191821_1441900429","dateCreated":"2025-09-12T21:29:00-0300","dateStarted":"2025-10-03T17:04:56-0300","dateFinished":"2025-10-03T17:04:57-0300","status":"FINISHED"},{"text":"","user":"admin","dateUpdated":"2025-10-03T17:04:57-0300","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1759188731115_541521741","id":"paragraph_1759188731115_541521741","dateCreated":"2025-09-29T20:32:11-0300","status":"FINISHED","results":{}}],"name":"Clase 06 - ML Pipelines","id":"2M6P9UTPP","defaultInterpreterGroup":"spark","version":"0.12.0","noteParams":{},"noteForms":{},"angularObjects":{},"config":{"isZeppelinNotebookCronEnable":false,"looknfeel":"default","personalizedMode":"false"},"info":{},"path":"/Clase 06 - ML Pipelines"}