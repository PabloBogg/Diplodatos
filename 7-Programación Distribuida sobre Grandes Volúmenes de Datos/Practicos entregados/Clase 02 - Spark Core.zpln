},\\\"params\\\":{}},{\\\"id\\\":\\\"20191206-163757_2138250663\\\",\\\"title\\\":\\\"Hay que crear el DF de vértices\\\",\\\"paragraph\\\":\\\"%pyspark\\\\n\\\\nsrcs = edgesDF.select(col(\\\\\\\"src\\\\\\\").alias(\\\\\\\"id\\\\\\\"))\\\\n\\\\ndsts = edgesDF.select(col(\\\\\\\"dst\\\\\\\").alias(\\\\\\\"id\\\\\\\"))\\\\n    \\\\nvertexDF = srcs.unionAll(dsts).distinct()\\\\n\\\\nz.show(vertexDF.limit(10))\\\\n    \\\",\\\"config\\\":{\\\"editorSetting\\\":{\\\"language\\\":\\\"python\\\",\\\"editOnDblClick\\\":false,\\\"completionKey\\\":\\\"TAB\\\",\\\"completionSupport\\\":true},\\\"colWidth\\\":6,\\\"editorMode\\\":\\\"ace/mode/python\\\",\\\"fontSize\\\":14,\\\"title\\\":true,\\\"results\\\":{\\\"0\\\":{\\\"graph\\\":{\\\"mode\\\":\\\"table\\\",\\\"height\\\":300,\\\"optionOpen\\\":false,\\\"setting\\\":{\\\"table\\\":{\\\"tableGridState\\\":{},\\\"tableColumnTypeState\\\":{\\\"names\\\":{\\\"id\\\":\\\"string\\\"},\\\"updated\\\":false},\\\"tableOptionSpecHash\\\":\\\"[{\\\\\\\"name\\\\\\\":\\\\\\\"useFilter\\\\\\\",\\\\\\\"valueType\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"defaultValue\\\\\\\":false,\\\\\\\"widget\\\\\\\":\\\\\\\"checkbox\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Enable filter for columns\\\\\\\"},{\\\\\\\"name\\\\\\\":\\\\\\\"showPagination\\\\\\\",\\\\\\\"valueType\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"defaultValue\\\\\\\":false,\\\\\\\"widget\\\\\\\":\\\\\\\"checkbox\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Enable pagination for better navigation\\\\\\\"},{\\\\\\\"name\\\\\\\":\\\\\\\"showAggregationFooter\\\\\\\",\\\\\\\"valueType\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"defaultValue\\\\\\\":false,\\\\\\\"widget\\\\\\\":\\\\\\\"checkbox\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Enable a footer for displaying aggregated values\\\\\\\"}]\\\",\\\"tableOptionValue\\\":{\\\"useFilter\\\":false,\\\"showPagination\\\":false,\\\"showAggregationFooter\\\":false},\\\"updated\\\":false,\\\"initialized\\\":false}},\\\"commonSetting\\\":{}}}},\\\"enabled\\\":true},\\\"params\\\":{}},{\\\"id\\\":\\\"20171101-124739_82230555\\\",\\\"title\\\":\\\"Creación de GraphFrame:\\\",\\\"paragraph\\\":\\\"%pyspark\\\\n\\\\nfrom graphframes import *\\\\n\\\\ngraph = GraphFrame(vertexDF, edgesDF).cache()\\\\n\\\",\\\"config\\\":{\\\"editorSetting\\\":{\\\"language\\\":\\\"python\\\",\\\"editOnDblClick\\\":false,\\\"completionKey\\\":\\\"TAB\\\",\\\"completionSupport\\\":true},\\\"colWidth\\\":12,\\\"editorMode\\\":\\\"ace/mode/python\\\",\\\"fontSize\\\":14,\\\"title\\\":true,\\\"results\\\":{},\\\"enabled\\\":true},\\\"params\\\":{}},{\\\"id\\\":\\\"20171102-153102_880120870\\\",\\\"paragraph\\\":\\\"%md\\\\n### Operaciones básicas sobre grafos\\\\n\\\\n#### A continuación veremos como calcular: \\\\n* la cantidad de vértices (usuarios)\\\\n* la cantidad de arístas (conexiones)\\\\n* el grado de cada vértice (cantidad de conexiones por usuario)\\\",\\\"config\\\":{\\\"tableHide\\\":false,\\\"editorSetting\\\":{\\\"language\\\":\\\"markdown\\\",\\\"editOnDblClick\\\":true,\\\"completionSupport\\\":false},\\\"colWidth\\\":12,\\\"editorMode\\\":\\\"ace/mode/markdown\\\",\\\"editorHide\\\":true,\\\"fontSize\\\":9,\\\"results\\\":{},\\\"enabled\\\":true},\\\"params\\\":{}},{\\\"id\\\":\\\"20171101-124845_773490911\\\",\\\"title\\\":\\\"Tamaño del grafo\\\",\\\"paragraph\\\":\\\"%pyspark\\\\n\\\\nverticesCount = graph.vertices.count()\\\\n\\\\nedgesCount = graph.edges.count()\\\\n\\\\nprint(f\\\\\\\"\\\\\\\"\\\\\\\"%table\\\\nCantidad de usuarios \\\\\\\\t Cantidad de conexiones\\\\n{verticesCount} \\\\\\\\t {edgesCount}\\\\\\\"\\\\\\\"\\\\\\\")\\\\n\\\\n\\\",\\\"config\\\":{\\\"editorSetting\\\":{\\\"language\\\":\\\"python\\\",\\\"editOnDblClick\\\":false,\\\"completionKey\\\":\\\"TAB\\\",\\\"completionSupport\\\":true},\\\"colWidth\\\":12,\\\"editorMode\\\":\\\"ace/mode/python\\\",\\\"fontSize\\\":14,\\\"title\\\":true,\\\"results\\\":{\\\"0\\\":{\\\"graph\\\":{\\\"mode\\\":\\\"table\\\",\\\"height\\\":300,\\\"optionOpen\\\":false,\\\"setting\\\":{\\\"table\\\":{\\\"tableGridState\\\":{},\\\"tableColumnTypeState\\\":{\\\"names\\\":{\\\"Cantidad de usuarios \\\":\\\"string\\\",\\\" Cantidad de conecciones\\\":\\\"string\\\"},\\\"updated\\\":false},\\\"tableOptionSpecHash\\\":\\\"[{\\\\\\\"name\\\\\\\":\\\\\\\"useFilter\\\\\\\",\\\\\\\"valueType\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"defaultValue\\\\\\\":false,\\\\\\\"widget\\\\\\\":\\\\\\\"checkbox\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Enable filter for columns\\\\\\\"},{\\\\\\\"name\\\\\\\":\\\\\\\"showPagination\\\\\\\",\\\\\\\"valueType\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"defaultValue\\\\\\\":false,\\\\\\\"widget\\\\\\\":\\\\\\\"checkbox\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Enable pagination for better navigation\\\\\\\"},{\\\\\\\"name\\\\\\\":\\\\\\\"showAggregationFooter\\\\\\\",\\\\\\\"valueType\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"defaultValue\\\\\\\":false,\\\\\\\"widget\\\\\\\":\\\\\\\"checkbox\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Enable a footer for displaying aggregated values\\\\\\\"}]\\\",\\\"tableOptionValue\\\":{\\\"useFilter\\\":false,\\\"showPagination\\\":false,\\\"showAggregationFooter\\\":false},\\\"updated\\\":false,\\\"initialized\\\":false}},\\\"commonSetting\\\":{}}}},\\\"enabled\\\":true},\\\"params\\\":{}},{\\\"id\\\":\\\"20171102-131720_1147432214\\\",\\\"title\\\":\\\"Cantidad de conexiones por usuario\\\",\\\"paragraph\\\":\\\"%pyspark\\\\n\\\\nnodesDegree = graph.degrees\\\\n\\\\nsortedByDegree = nodesDegree.orderBy(\\\\\\\"degree\\\\\\\", ascending=False)\\\\n\\\\nz.show(sortedByDegree.limit(10))\\\\n\\\",\\\"config\\\":{\\\"editorSetting\\\":{\\\"language\\\":\\\"python\\\",\\\"editOnDblClick\\\":false,\\\"completionKey\\\":\\\"TAB\\\",\\\"completionSupport\\\":true},\\\"colWidth\\\":12,\\\"editorMode\\\":\\\"ace/mode/python\\\",\\\"fontSize\\\":14,\\\"title\\\":true,\\\"results\\\":{\\\"0\\\":{\\\"graph\\\":{\\\"mode\\\":\\\"table\\\",\\\"height\\\":300,\\\"optionOpen\\\":false,\\\"setting\\\":{\\\"table\\\":{\\\"tableGridState\\\":{},\\\"tableColumnTypeState\\\":{\\\"names\\\":{\\\"id\\\":\\\"string\\\",\\\"degree\\\":\\\"string\\\"},\\\"updated\\\":false},\\\"tableOptionSpecHash\\\":\\\"[{\\\\\\\"name\\\\\\\":\\\\\\\"useFilter\\\\\\\",\\\\\\\"valueType\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"defaultValue\\\\\\\":false,\\\\\\\"widget\\\\\\\":\\\\\\\"checkbox\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Enable filter for columns\\\\\\\"},{\\\\\\\"name\\\\\\\":\\\\\\\"showPagination\\\\\\\",\\\\\\\"valueType\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"defaultValue\\\\\\\":false,\\\\\\\"widget\\\\\\\":\\\\\\\"checkbox\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Enable pagination for better navigation\\\\\\\"},{\\\\\\\"name\\\\\\\":\\\\\\\"showAggregationFooter\\\\\\\",\\\\\\\"valueType\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"defaultValue\\\\\\\":false,\\\\\\\"widget\\\\\\\":\\\\\\\"checkbox\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Enable a footer for displaying aggregated values\\\\\\\"}]\\\",\\\"tableOptionValue\\\":{\\\"useFilter\\\":false,\\\"showPagination\\\":false,\\\"showAggregationFooter\\\":false},\\\"updated\\\":false,\\\"initialized\\\":false}},\\\"commonSetting\\\":{}}}},\\\"enabled\\\":true},\\\"params\\\":{}},{\\\"id\\\":\\\"20171102-132006_1774167041\\\",\\\"paragraph\\\":\\\"%md\\\\n\\\\n## Ejemplo Agregación de Mensajes\\\\n\\\\n### Influencia Colectiva\\\\n\\\\n#### Aplicaciones: \\\\n* Marketing viral (influencia de opinión)\\\\n* Detección de focos de dispersión de enfermedades\\\\n* ...\\\\n\\\\n#### Cómo funciona:\\\\n* Primero se calcula la **Influencia Colectiva (CI)**\\\\n* En cada iteración elimina del grafo el nodo de mayor CI y recalcula el CI de los nodos restantes\\\\n* Termina cuando la componente gigante se destruye\\\\n* Solución básica: \\\\\\\\\\\\\\\\(O(N2)\\\\\\\\\\\\\\\\). Optimizada: \\\\\\\\\\\\\\\\(O(NlogN)\\\\\\\\\\\\\\\\)\\\\n\\\\n> Influence maximization in complex networks through optimal percolation” (Flaviano Morone, Hernán A. Makse, 27 Jun 2015) https://arxiv.org/abs/1506.08326\\\\n\\\\n\\\\n\\\",\\\"config\\\":{\\\"tableHide\\\":false,\\\"editorSetting\\\":{\\\"language\\\":\\\"markdown\\\",\\\"editOnDblClick\\\":true,\\\"completionSupport\\\":false},\\\"colWidth\\\":12,\\\"editorMode\\\":\\\"ace/mode/markdown\\\",\\\"editorHide\\\":true,\\\"fontSize\\\":9,\\\"results\\\":{},\\\"enabled\\\":true},\\\"params\\\":{}},{\\\"id\\\":\\\"20171102-131904_821311339\\\",\\\"paragraph\\\":\\\"%md\\\\n### Fórmula de CI\\\\n\\\\nLa formula de collective influence para un vértice \\\\\\\\\\\\\\\\(i\\\\\\\\\\\\\\\\) es:\\\\n\\\\n$$ CI(i) = (degree_i -  1) \\\\\\\\times \\\\\\\\sum\\\\\\\\limits_{j \\\\\\\\in vecinos(i)} (degree_j -  1)$$\\\\n\\\\nSe supone un grafo **no dirigido**.\\\\n\\\\n### Pasos para calcular collective influence son:\\\\n\\\\n* agregar el grado (degree) de cada nodo al grafo.\\\\n* importar `AggregateMessages`.\\\\n* calcular collective influence de cada individuo usando `AggregateMessages` de `GraphFrame`\\\\n* ordenar los individuos por su collective influence de mayor a menor\\\\n* imprimir el listado de individuos\\\\n\\\\n\\\\n#### Documentación para implementar con GraphFrames:\\\\n\\\\n* Documentación sobre [AggregateMessages](https://graphframes.io/04-user-guide/09-aggregate-messages.html) con ejemplo.\\\\n* Documentación de [API AggregateMessages](https://graphframes.io/api/python/graphframes.lib.html#graphframes.lib.AggregateMessages).\\\\n\\\",\\\"config\\\":{\\\"tableHide\\\":false,\\\"editorSetting\\\":{\\\"language\\\":\\\"markdown\\\",\\\"editOnDblClick\\\":true,\\\"completionSupport\\\":false},\\\"colWidth\\\":12,\\\"editorMode\\\":\\\"ace/mode/markdown\\\",\\\"editorHide\\\":true,\\\"fontSize\\\":9,\\\"results\\\":{},\\\"enabled\\\":true},\\\"params\\\":{}},{\\\"id\\\":\\\"20171101-125025_1054455316\\\",\\\"paragraph\\\":\\\"%pyspark\\\\n\\\\nfrom pyspark.sql.functions import sum\\\\nfrom graphframes.lib import AggregateMessages as AM\\\\n\\\\n#Creo un nuevo grafo con los nodos y su degree (disponible en nodesDegree) y las aristas originales\\\\ndegreeGraph = GraphFrame(nodesDegree, graph.edges )\\\\n# Aristas y vértices están bien particionadas\\\\n\\\\n\\\\n# Comenzamos a calcular CI \\\\n\\\\n# Cada nodo envia su degree-1 a sus vecinos a traves de sus conexiones salientes y entrantes\\\\nmsgToDst = AM.src[\\\\\\\"degree\\\\\\\"] - 1\\\\nmsgToSrc = AM.dst[\\\\\\\"degree\\\\\\\"] - 1\\\\n\\\\n# El DataFrame sumNeighborDegrees debe tener 2 columnas: id del nodo y sum_neighbor_degree \\\\nsumNeighborDegrees = degreeGraph.aggregateMessages(\\\\n    sum(AM.msg).alias(\\\\\\\"sum_neighbor_degree\\\\\\\"), # Hace aggregation en cada nodo sobre los mensages recibidos \\\\n    sendToDst=msgToDst, # Envia a vecino por conexion saliente\\\\n    sendToSrc=msgToSrc) # Envia a vecino por conexion entrante\\\\n\\\\n# Join de sumNeighborDegrees con degrees para tener todas las columnas necesarias para calcular CI.\\\\n\\\\nnodesDegreeJoin = nodesDegree.join(sumNeighborDegrees,\\\\\\\"id\\\\\\\")\\\\n\\\\n# Calculamos CI: para terminar de calcularlo debemos multiplicar la sumatoria del paso anterior por degree - 1 de cada nodo.\\\\n# El DataFrame collectiveInfluence debe tener 3 columnas: id, ci y degree\\\\n# Por ultimo ordena descendentemente por ci \\\\n\\\\ncollectiveInfluence = nodesDegreeJoin \\\\\\\\\\\\n    .select(((col(\\\\\\\"degree\\\\\\\") - 1) * col(\\\\\\\"sum_neighbor_degree\\\\\\\")).alias(\\\\\\\"ci\\\\\\\"),\\\\n            \\\\\\\"id\\\\\\\",\\\\n            \\\\\\\"degree\\\\\\\") \\\\\\\\\\\\n    .orderBy(\\\\\\\"ci\\\\\\\", ascending=False) \\\\\\\\\\\\n    .cache()\\\\n\\\\nz.show(collectiveInfluence.limit(20))\\\\n\\\",\\\"config\\\":{\\\"editorSetting\\\":{\\\"language\\\":\\\"python\\\",\\\"editOnDblClick\\\":false,\\\"completionKey\\\":\\\"TAB\\\",\\\"completionSupport\\\":true},\\\"colWidth\\\":12,\\\"editorMode\\\":\\\"ace/mode/python\\\",\\\"fontSize\\\":14,\\\"results\\\":{\\\"0\\\":{\\\"graph\\\":{\\\"mode\\\":\\\"table\\\",\\\"height\\\":300,\\\"optionOpen\\\":false,\\\"setting\\\":{\\\"table\\\":{\\\"tableGridState\\\":{},\\\"tableColumnTypeState\\\":{\\\"names\\\":{\\\"ci\\\":\\\"string\\\",\\\"id\\\":\\\"string\\\",\\\"degree\\\":\\\"string\\\"},\\\"updated\\\":false},\\\"tableOptionSpecHash\\\":\\\"[{\\\\\\\"name\\\\\\\":\\\\\\\"useFilter\\\\\\\",\\\\\\\"valueType\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"defaultValue\\\\\\\":false,\\\\\\\"widget\\\\\\\":\\\\\\\"checkbox\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Enable filter for columns\\\\\\\"},{\\\\\\\"name\\\\\\\":\\\\\\\"showPagination\\\\\\\",\\\\\\\"valueType\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"defaultValue\\\\\\\":false,\\\\\\\"widget\\\\\\\":\\\\\\\"checkbox\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Enable pagination for better navigation\\\\\\\"},{\\\\\\\"name\\\\\\\":\\\\\\\"showAggregationFooter\\\\\\\",\\\\\\\"valueType\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"defaultValue\\\\\\\":false,\\\\\\\"widget\\\\\\\":\\\\\\\"checkbox\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Enable a footer for displaying aggregated values\\\\\\\"}]\\\",\\\"tableOptionValue\\\":{\\\"useFilter\\\":false,\\\"showPagination\\\":false,\\\"showAggregationFooter\\\":false},\\\"updated\\\":false,\\\"initialized\\\":false}},\\\"commonSetting\\\":{}}}},\\\"enabled\\\":true},\\\"params\\\":{}},{\\\"id\\\":\\\"20181027-013740_419047675\\\",\\\"paragraph\\\":\\\"%md\\\\n## Motif Finding\\\\n\\\\n* Es un Domain-Specific Language (DSL) para expresar queries.\\\\n* La unidad básica es la expresión de una arista\\\\n\\\\n### Ejemplos\\\\n\\\\n* `graph.find(\\\\\\\"(a)-[e]->(b); (b)-[e2]->(a)\\\\\\\")` expresa vértices unidos en ambas direcciones.\\\\n    - Devuelve un DataFrame con columnas `\\\\\\\"a\\\\\\\"`, `\\\\\\\"b\\\\\\\"`, `\\\\\\\"e\\\\\\\"` y `\\\\\\\"e2\\\\\\\"`.\\\\n* `graph.find(\\\\\\\"(a)-[e]->(b); (b)-[e2]->(c)\\\\\\\")` expresa dos aristas pegadas con un vértice común `b`. \\\\n\\\\n### Documentacion y ejemplo\\\\n\\\\n* [GraphFrame User Guide](https://graphframes.io/04-user-guide/04-motif-finding.html).\\\\n\\\",\\\"config\\\":{\\\"tableHide\\\":false,\\\"editorSetting\\\":{\\\"language\\\":\\\"markdown\\\",\\\"editOnDblClick\\\":true,\\\"completionSupport\\\":false},\\\"colWidth\\\":12,\\\"editorMode\\\":\\\"ace/mode/markdown\\\",\\\"editorHide\\\":true,\\\"fontSize\\\":9,\\\"results\\\":{},\\\"enabled\\\":true},\\\"params\\\":{}},{\\\"id\\\":\\\"paragraph_1634934672760_445886262\\\",\\\"paragraph\\\":\\\"%md\\\\n### Recordemos el grafo\\\",\\\"config\\\":{\\\"tableHide\\\":false,\\\"editorSetting\\\":{\\\"language\\\":\\\"markdown\\\",\\\"editOnDblClick\\\":true,\\\"completionKey\\\":\\\"TAB\\\",\\\"completionSupport\\\":false},\\\"colWidth\\\":12,\\\"editorMode\\\":\\\"ace/mode/markdown\\\",\\\"fontSize\\\":9,\\\"editorHide\\\":true,\\\"results\\\":{},\\\"enabled\\\":true},\\\"params\\\":{}},{\\\"id\\\":\\\"paragraph_1634934258381_857174466\\\",\\\"paragraph\\\":\\\"%pyspark\\\\nz.show(g.vertices)\\\",\\\"config\\\":{\\\"editorSetting\\\":{\\\"language\\\":\\\"python\\\",\\\"editOnDblClick\\\":false,\\\"completionKey\\\":\\\"TAB\\\",\\\"completionSupport\\\":true},\\\"colWidth\\\":6,\\\"editorMode\\\":\\\"ace/mode/python\\\",\\\"fontSize\\\":14,\\\"results\\\":{\\\"0\\\":{\\\"graph\\\":{\\\"mode\\\":\\\"table\\\",\\\"height\\\":300,\\\"optionOpen\\\":false,\\\"setting\\\":{\\\"table\\\":{\\\"tableGridState\\\":{},\\\"tableColumnTypeState\\\":{\\\"names\\\":{\\\"id\\\":\\\"string\\\",\\\"name\\\":\\\"string\\\",\\\"age\\\":\\\"string\\\"},\\\"updated\\\":false},\\\"tableOptionSpecHash\\\":\\\"[{\\\\\\\"name\\\\\\\":\\\\\\\"useFilter\\\\\\\",\\\\\\\"valueType\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"defaultValue\\\\\\\":false,\\\\\\\"widget\\\\\\\":\\\\\\\"checkbox\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Enable filter for columns\\\\\\\"},{\\\\\\\"name\\\\\\\":\\\\\\\"showPagination\\\\\\\",\\\\\\\"valueType\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"defaultValue\\\\\\\":false,\\\\\\\"widget\\\\\\\":\\\\\\\"checkbox\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Enable pagination for better navigation\\\\\\\"},{\\\\\\\"name\\\\\\\":\\\\\\\"showAggregationFooter\\\\\\\",\\\\\\\"valueType\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"defaultValue\\\\\\\":false,\\\\\\\"widget\\\\\\\":\\\\\\\"checkbox\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Enable a footer for displaying aggregated values\\\\\\\"}]\\\",\\\"tableOptionValue\\\":{\\\"useFilter\\\":false,\\\"showPagination\\\":false,\\\"showAggregationFooter\\\":false},\\\"updated\\\":false,\\\"initialized\\\":false}},\\\"commonSetting\\\":{}}}},\\\"enabled\\\":true},\\\"params\\\":{}},{\\\"id\\\":\\\"paragraph_1634934349934_2020230166\\\",\\\"paragraph\\\":\\\"%pyspark\\\\nz.show(g.edges)\\\",\\\"config\\\":{\\\"editorSetting\\\":{\\\"language\\\":\\\"python\\\",\\\"editOnDblClick\\\":false,\\\"completionKey\\\":\\\"TAB\\\",\\\"completionSupport\\\":true},\\\"colWidth\\\":6,\\\"editorMode\\\":\\\"ace/mode/python\\\",\\\"fontSize\\\":14,\\\"results\\\":{\\\"0\\\":{\\\"graph\\\":{\\\"mode\\\":\\\"table\\\",\\\"height\\\":300,\\\"optionOpen\\\":false,\\\"setting\\\":{\\\"table\\\":{\\\"tableGridState\\\":{},\\\"tableColumnTypeState\\\":{\\\"names\\\":{\\\"src\\\":\\\"string\\\",\\\"dst\\\":\\\"string\\\",\\\"relationship\\\":\\\"string\\\"},\\\"updated\\\":true},\\\"tableOptionSpecHash\\\":\\\"[{\\\\\\\"name\\\\\\\":\\\\\\\"useFilter\\\\\\\",\\\\\\\"valueType\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"defaultValue\\\\\\\":false,\\\\\\\"widget\\\\\\\":\\\\\\\"checkbox\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Enable filter for columns\\\\\\\"},{\\\\\\\"name\\\\\\\":\\\\\\\"showPagination\\\\\\\",\\\\\\\"valueType\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"defaultValue\\\\\\\":false,\\\\\\\"widget\\\\\\\":\\\\\\\"checkbox\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Enable pagination for better navigation\\\\\\\"},{\\\\\\\"name\\\\\\\":\\\\\\\"showAggregationFooter\\\\\\\",\\\\\\\"valueType\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"defaultValue\\\\\\\":false,\\\\\\\"widget\\\\\\\":\\\\\\\"checkbox\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Enable a footer for displaying aggregated values\\\\\\\"}]\\\",\\\"tableOptionValue\\\":{\\\"useFilter\\\":false,\\\"showPagination\\\":false,\\\"showAggregationFooter\\\":false},\\\"updated\\\":false,\\\"initialized\\\":false}},\\\"commonSetting\\\":{}}}},\\\"enabled\\\":true},\\\"params\\\":{}},{\\\"id\\\":\\\"paragraph_1634934687488_918172403\\\",\\\"paragraph\\\":\\\"%md\\\\n### Hagamos algunos queries\\\",\\\"config\\\":{\\\"tableHide\\\":false,\\\"editorSetting\\\":{\\\"language\\\":\\\"markdown\\\",\\\"editOnDblClick\\\":true,\\\"completionKey\\\":\\\"TAB\\\",\\\"completionSupport\\\":false},\\\"colWidth\\\":12,\\\"editorMode\\\":\\\"ace/mode/markdown\\\",\\\"fontSize\\\":9,\\\"editorHide\\\":true,\\\"results\\\":{},\\\"enabled\\\":false},\\\"params\\\":{}},{\\\"id\\\":\\\"20181027-015100_1394496292\\\",\\\"paragraph\\\":\\\"%pyspark\\\\n\\\\n# Buscar pares de vértices en ambas direccione:\\\\nmotifs = g.find(\\\\\\\"(a)-[e1]->(b); (b)-[e2]->(a)\\\\\\\")\\\\n\\\\nmotifs.printSchema()\\\\n\\\",\\\"config\\\":{\\\"editorSetting\\\":{\\\"language\\\":\\\"python\\\",\\\"editOnDblClick\\\":false,\\\"completionKey\\\":\\\"TAB\\\",\\\"completionSupport\\\":true},\\\"colWidth\\\":6,\\\"editorMode\\\":\\\"ace/mode/python\\\",\\\"fontSize\\\":14,\\\"editorHide\\\":false,\\\"results\\\":{},\\\"enabled\\\":true},\\\"params\\\":{}},{\\\"id\\\":\\\"20181027-015533_344573808\\\",\\\"paragraph\\\":\\\"%pyspark\\\\n\\\\nz.show(motifs)\\\\n\\\",\\\"config\\\":{\\\"editorSetting\\\":{\\\"language\\\":\\\"python\\\",\\\"editOnDblClick\\\":false,\\\"completionKey\\\":\\\"TAB\\\",\\\"completionSupport\\\":true},\\\"colWidth\\\":6,\\\"editorMode\\\":\\\"ace/mode/python\\\",\\\"fontSize\\\":14,\\\"results\\\":{\\\"0\\\":{\\\"graph\\\":{\\\"mode\\\":\\\"table\\\",\\\"height\\\":300,\\\"optionOpen\\\":false,\\\"setting\\\":{\\\"table\\\":{\\\"tableGridState\\\":{},\\\"tableColumnTypeState\\\":{\\\"names\\\":{\\\"a\\\":\\\"string\\\",\\\"e1\\\":\\\"string\\\",\\\"b\\\":\\\"string\\\",\\\"e2\\\":\\\"string\\\"},\\\"updated\\\":false},\\\"tableOptionSpecHash\\\":\\\"[{\\\\\\\"name\\\\\\\":\\\\\\\"useFilter\\\\\\\",\\\\\\\"valueType\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"defaultValue\\\\\\\":false,\\\\\\\"widget\\\\\\\":\\\\\\\"checkbox\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Enable filter for columns\\\\\\\"},{\\\\\\\"name\\\\\\\":\\\\\\\"showPagination\\\\\\\",\\\\\\\"valueType\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"defaultValue\\\\\\\":false,\\\\\\\"widget\\\\\\\":\\\\\\\"checkbox\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Enable pagination for better navigation\\\\\\\"},{\\\\\\\"name\\\\\\\":\\\\\\\"showAggregationFooter\\\\\\\",\\\\\\\"valueType\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"defaultValue\\\\\\\":false,\\\\\\\"widget\\\\\\\":\\\\\\\"checkbox\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Enable a footer for displaying aggregated values\\\\\\\"}]\\\",\\\"tableOptionValue\\\":{\\\"useFilter\\\":false,\\\"showPagination\\\":false,\\\"showAggregationFooter\\\":false},\\\"updated\\\":false,\\\"initialized\\\":false}},\\\"commonSetting\\\":{}}}},\\\"enabled\\\":true},\\\"params\\\":{}},{\\\"id\\\":\\\"20201030-112416_1681452862\\\",\\\"paragraph\\\":\\\"%pyspark\\\\n# Despues se pueden aplicar filtros para queries mas complejos.\\\\nz.show(motifs.filter(\\\\\\\"b.age > 30\\\\\\\"))\\\\n\\\",\\\"config\\\":{\\\"editorSetting\\\":{\\\"language\\\":\\\"python\\\",\\\"editOnDblClick\\\":false,\\\"completionKey\\\":\\\"TAB\\\",\\\"completionSupport\\\":true},\\\"colWidth\\\":12,\\\"editorMode\\\":\\\"ace/mode/python\\\",\\\"fontSize\\\":14,\\\"results\\\":{\\\"0\\\":{\\\"graph\\\":{\\\"mode\\\":\\\"table\\\",\\\"height\\\":300,\\\"optionOpen\\\":false,\\\"setting\\\":{\\\"table\\\":{\\\"tableGridState\\\":{},\\\"tableColumnTypeState\\\":{\\\"names\\\":{\\\"a\\\":\\\"string\\\",\\\"e1\\\":\\\"string\\\",\\\"b\\\":\\\"string\\\",\\\"e2\\\":\\\"string\\\"},\\\"updated\\\":false},\\\"tableOptionSpecHash\\\":\\\"[{\\\\\\\"name\\\\\\\":\\\\\\\"useFilter\\\\\\\",\\\\\\\"valueType\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"defaultValue\\\\\\\":false,\\\\\\\"widget\\\\\\\":\\\\\\\"checkbox\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Enable filter for columns\\\\\\\"},{\\\\\\\"name\\\\\\\":\\\\\\\"showPagination\\\\\\\",\\\\\\\"valueType\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"defaultValue\\\\\\\":false,\\\\\\\"widget\\\\\\\":\\\\\\\"checkbox\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Enable pagination for better navigation\\\\\\\"},{\\\\\\\"name\\\\\\\":\\\\\\\"showAggregationFooter\\\\\\\",\\\\\\\"valueType\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"defaultValue\\\\\\\":false,\\\\\\\"widget\\\\\\\":\\\\\\\"checkbox\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Enable a footer for displaying aggregated values\\\\\\\"}]\\\",\\\"tableOptionValue\\\":{\\\"useFilter\\\":false,\\\"showPagination\\\":false,\\\"showAggregationFooter\\\":false},\\\"updated\\\":false,\\\"initialized\\\":false}},\\\"commonSetting\\\":{}}}},\\\"enabled\\\":true},\\\"params\\\":{}},{\\\"id\\\":\\\"20171102-160936_360694508\\\",\\\"paragraph\\\":\\\"%md\\\\n## Visualización\\\\n\\\\nA continuación visualizaremos con [Gephi](https://gephi.org/) la parte del grafo (subgrafo) que contiene los mayores influencers.\\\\n\\\\nPara ello generaremos archivos *csv* como entrada de esta herramienta \\\",\\\"config\\\":{\\\"tableHide\\\":false,\\\"editorSetting\\\":{\\\"language\\\":\\\"markdown\\\",\\\"editOnDblClick\\\":true},\\\"colWidth\\\":12,\\\"editorMode\\\":\\\"ace/mode/markdown\\\",\\\"editorHide\\\":true,\\\"fontSize\\\":9,\\\"results\\\":{},\\\"enabled\\\":false},\\\"params\\\":{}},{\\\"id\\\":\\\"20171102-000354_1806019706\\\",\\\"paragraph\\\":\\\"%pyspark\\\\n\\\\nminCI = 29000000\\\\nminDegree = 600\\\\n\\\\n# tomo los usarios con mayor influencia o con más conexiones\\\\nciTops = collectiveInfluence \\\\\\\\\\\\n    .filter((col(\\\\\\\"ci\\\\\\\") >= minCI) | (col(\\\\\\\"degree\\\\\\\") >= minDegree))\\\\n\\\\ngInfluencers = GraphFrame(ciTops, graph.edges)\\\\n\\\\n# Tomo solo las aristas que tengan vértices\\\\nveTops = gInfluencers \\\\\\\\\\\\n    .find(\\\\\\\"(a)-[e]->(b)\\\\\\\") \\\\\\\\\\\\n    .cache()\\\\n      \\\\n                \\\\nprint(\\\\\\\"Cantidad de top influencers:\\\\\\\", veTops.count())\\\\n\\\\nveTops.printSchema()\\\\n\\\",\\\"config\\\":{\\\"editorSetting\\\":{\\\"language\\\":\\\"python\\\",\\\"editOnDblClick\\\":false,\\\"completionKey\\\":\\\"TAB\\\",\\\"completionSupport\\\":true},\\\"colWidth\\\":6,\\\"editorMode\\\":\\\"ace/mode/python\\\",\\\"fontSize\\\":14,\\\"results\\\":{\\\"1\\\":{\\\"graph\\\":{\\\"mode\\\":\\\"table\\\",\\\"height\\\":300,\\\"optionOpen\\\":false,\\\"setting\\\":{\\\"table\\\":{\\\"tableGridState\\\":{},\\\"tableColumnTypeState\\\":{\\\"names\\\":{\\\"a\\\":\\\"string\\\",\\\"e\\\":\\\"string\\\",\\\"b\\\":\\\"string\\\"},\\\"updated\\\":false},\\\"tableOptionSpecHash\\\":\\\"[{\\\\\\\"name\\\\\\\":\\\\\\\"useFilter\\\\\\\",\\\\\\\"valueType\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"defaultValue\\\\\\\":false,\\\\\\\"widget\\\\\\\":\\\\\\\"checkbox\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Enable filter for columns\\\\\\\"},{\\\\\\\"name\\\\\\\":\\\\\\\"showPagination\\\\\\\",\\\\\\\"valueType\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"defaultValue\\\\\\\":false,\\\\\\\"widget\\\\\\\":\\\\\\\"checkbox\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Enable pagination for better navigation\\\\\\\"},{\\\\\\\"name\\\\\\\":\\\\\\\"showAggregationFooter\\\\\\\",\\\\\\\"valueType\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"defaultValue\\\\\\\":false,\\\\\\\"widget\\\\\\\":\\\\\\\"checkbox\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Enable a footer for displaying aggregated values\\\\\\\"}]\\\",\\\"tableOptionValue\\\":{\\\"useFilter\\\":false,\\\"showPagination\\\":false,\\\"showAggregationFooter\\\":false},\\\"updated\\\":false,\\\"initialized\\\":false}},\\\"commonSetting\\\":{}}}},\\\"enabled\\\":true},\\\"params\\\":{}},{\\\"id\\\":\\\"20181027-020144_852191582\\\",\\\"paragraph\\\":\\\"%pyspark\\\\n\\\\neTops = veTops.select(\\\\\\\"e.*\\\\\\\")\\\\n\\\\neTops.printSchema()\\\\n\\\\n# Grafo de los tops\\\\ngTops = GraphFrame(ciTops, eTops)\\\\n\\\\n# guardo un csv con los vertices para Gephi\\\\n# Label es igual a la id\\\\ngTops.vertices \\\\\\\\\\\\n    .select(\\\\\\\"*\\\\\\\", col(\\\\\\\"id\\\\\\\").alias(\\\\\\\"Label\\\\\\\")) \\\\\\\\\\\\n    .coalesce(1) \\\\\\\\\\\\n    .write \\\\\\\\\\\\n    .csv(\\\\\\\"conf/top_influencers.csv\\\\\\\", mode=\\\\\\\"overwrite\\\\\\\", header=True)\\\\n\\\\n# guardo un csv con las aristas para Gephi\\\\ngTops.edges \\\\\\\\\\\\n    .select(col(\\\\\\\"src\\\\\\\").alias(\\\\\\\"Source\\\\\\\"), \\\\n            col(\\\\\\\"dst\\\\\\\").alias(\\\\\\\"Target\\\\\\\"), \\\\n            \\\\\\\"count_RT\\\\\\\",\\\\\\\"count_distinct_RT\\\\\\\") \\\\\\\\\\\\n    .coalesce(1) \\\\\\\\\\\\n    .write \\\\\\\\\\\\n    .csv(\\\\\\\"conf/top_edges.csv\\\\\\\", mode=\\\\\\\"overwrite\\\\\\\", header=True)\\\\n\\\",\\\"config\\\":{\\\"editorSetting\\\":{\\\"language\\\":\\\"python\\\",\\\"editOnDblClick\\\":false,\\\"completionKey\\\":\\\"TAB\\\",\\\"completionSupport\\\":true},\\\"colWidth\\\":6,\\\"editorMode\\\":\\\"ace/mode/python\\\",\\\"fontSize\\\":14,\\\"results\\\":{},\\\"enabled\\\":true,\\\"tableHide\\\":true},\\\"params\\\":{}},{\\\"id\\\":\\\"20171102-161414_1207858851\\\",\\\"paragraph\\\":\\\"%md\\\\n### [Gephi](https://gephi.org/)\\\\n\\\\nLanzar el programa desde una terminal ejecutando:\\\\n\\\\n```sh\\\\ngephi-0.10.1/bin/gephi\\\\n```\\\\n\\\\nSeguir las instrucciones del profesor.\\\",\\\"config\\\":{\\\"tableHide\\\":false,\\\"editorSetting\\\":{\\\"language\\\":\\\"markdown\\\",\\\"editOnDblClick\\\":true,\\\"completionSupport\\\":false},\\\"colWidth\\\":12,\\\"editorMode\\\":\\\"ace/mode/markdown\\\",\\\"editorHide\\\":true,\\\"fontSize\\\":9,\\\"results\\\":{},\\\"enabled\\\":true},\\\"params\\\":{}},{\\\"id\\\":\\\"20171102-110542_600666434\\\",\\\"paragraph\\\":\\\"%md\\\\n### Ejercicio\\\\n\\\\nComplete el siguiente programa para calcular el grafo de todas las conexiones **desde** los 8 mayores influenciadores (influencia colectiva).\\\\n\\\\nInstalar y graficar el resultado con [Gephi](https://gephi.org/). \\\\n\\\\n#### Ayuda\\\\n* Busque en la documentación [Api Datasets](https://spark.apache.org/docs/latest/api/python/reference/pyspark.sql/index.html) algún método que devuelva las *n* primeras files de un Dataset equivalente a la directiva SQL `LIMIT`. \\\\n* Para llenar el comando `find` busque la documentación de [Motif finding](https://graphframes.io/04-user-guide/04-motif-finding.html).\\\\n* Cantidad de vertices = 120, cantidad de aristas = 122.\\\",\\\"config\\\":{\\\"tableHide\\\":false,\\\"editorSetting\\\":{\\\"language\\\":\\\"markdown\\\",\\\"editOnDblClick\\\":true,\\\"completionSupport\\\":false},\\\"colWidth\\\":12,\\\"editorMode\\\":\\\"ace/mode/markdown\\\",\\\"editorHide\\\":true,\\\"fontSize\\\":12,\\\"results\\\":{},\\\"enabled\\\":true},\\\"params\\\":{}},{\\\"id\\\":\\\"paragraph_1666384803023_696454822\\\",\\\"paragraph\\\":\\\"%pyspark\\\\n\\\\ntopInfluencers = collectiveInfluence \\\\\\\\\\\\n    .orderBy(\\\\\\\"ci\\\\\\\", ascending=False) \\\\\\\\\\\\n    .limit(8) # solo los 8 primeros\\\\n\\\\nz.show(topInfluencers)\\\\n\\\\nprint(\\\\\\\"Edges and vertices:\\\\\\\", graph.edges.count(), graph.vertices.count())\\\\n\\\\n# gTops2 = GraphFrame(topInfluencers, graph.edges)\\\\n\\\\n\\\\n# # Solo las aristas que salen desde los tops\\\\n# res1 = gTops2.find(\\\\\\\"(a)-[e]->(b)\\\\\\\")\\\\n# print(\\\\\\\"count res1\\\\\\\", res1.count())\\\\n\\\\n# eTops2 = res1.select(\\\\\\\"e.src\\\\\\\", \\\\\\\"e.dst\\\\\\\")\\\\n\\\\n# # Junto todos los vertices de las aristas\\\\n# vTops2s = eTops2.select(col(\\\\\\\"src\\\\\\\").alias(\\\\\\\"id\\\\\\\"))\\\\n# vTops2d = eTops2.select(col(\\\\\\\"dst\\\\\\\").alias(\\\\\\\"id\\\\\\\"))\\\\n# vTops2sd = vTops2s.union(vTops2d).distinct()\\\\n\\\\n# print(\\\\\\\"Count:\\\\\\\", vTops2sd.count())\\\\n# z.show(vTops2sd)\\\\n\\\\n# # Agrego ci a los vertices con left join\\\\n# vTops2 = vTops2sd.join(collectiveInfluence, \\\\\\\"id\\\\\\\", \\\\\\\"left\\\\\\\").distinct()\\\\n\\\\n# print(\\\\\\\"Cantidad de vertices\\\\\\\", vTops2.count())\\\\n\\\\n# # Agrego columna con nombre para Gephi y guardo csv vertices\\\\n# vTops2 \\\\\\\\\\\\n#     .select(\\\\\\\"*\\\\\\\", col(\\\\\\\"id\\\\\\\").alias(\\\\\\\"Label\\\\\\\"))\\\\\\\\\\\\n#     .coalesce(1) \\\\\\\\\\\\n#     .write.csv(\\\\\\\"conf/top_influencers2.csv\\\\\\\", mode=\\\\\\\"overwrite\\\\\\\", header=True)\\\\n\\\\n# print(\\\\\\\"Cantidad de aristas\\\\\\\", eTops2.count())\\\\n\\\\n# # Agrego columnas con nombres para Gephi y guardo csv aristas\\\\n# eTops2 \\\\\\\\\\\\n#     .withColumnRenamed(\\\\\\\"src\\\\\\\", \\\\\\\"Source\\\\\\\") \\\\\\\\\\\\n#     .withColumnRenamed(\\\\\\\"dst\\\\\\\", \\\\\\\"Target\\\\\\\") \\\\\\\\\\\\n#     .coalesce(1) \\\\\\\\\\\\n#     .write.csv(\\\\\\\"conf/top_edges2.csv\\\\\\\", mode=\\\\\\\"overwrite\\\\\\\", header=True)\\\",\\\"config\\\":{\\\"editorSetting\\\":{\\\"language\\\":\\\"python\\\",\\\"editOnDblClick\\\":false,\\\"completionKey\\\":\\\"TAB\\\",\\\"completionSupport\\\":true},\\\"colWidth\\\":12,\\\"editorMode\\\":\\\"ace/mode/python\\\",\\\"fontSize\\\":14,\\\"results\\\":{},\\\"enabled\\\":true},\\\"params\\\":{}},{\\\"id\\\":\\\"20201030-122513_420199213\\\",\\\"paragraph\\\":\\\"%md\\\\n### Ejercicio\\\\n\\\\n0. Tomar el grafo de tweets y crear un dataframe con todas las aristas y vértices que forman triángulos dirigidos. O sea, todos los casos donde un usuario *A* retuitea a *B* que retuitea a *C* que retuitea a *A*.\\\\n\\\\n0. Hay casos donde los tres usuarios sean distintos?\\\\n\\\\n0. Graficar con Gephi el último resultado.\\\\n\\\\n#### Ayuda\\\\n\\\\n* Cantidad de vertices = 415, cantidad de aristas = 1006.\\\\n\\\",\\\"config\\\":{\\\"tableHide\\\":false,\\\"editorSetting\\\":{\\\"language\\\":\\\"markdown\\\",\\\"editOnDblClick\\\":true,\\\"completionKey\\\":\\\"TAB\\\",\\\"completionSupport\\\":false},\\\"colWidth\\\":12,\\\"editorMode\\\":\\\"ace/mode/markdown\\\",\\\"fontSize\\\":12,\\\"editorHide\\\":true,\\\"results\\\":{},\\\"enabled\\\":true},\\\"params\\\":{}},{\\\"id\\\":\\\"20171010-191336_1667301043\\\",\\\"title\\\":\\\"FIN\\\",\\\"paragraph\\\":\\\"val baseDir=\\\\\\\"https://git.cs.famaf.unc.edu.ar/dbarsotti/diplodatos_bigdata/raw/master/clases\\\\\\\"\\\\n\\\\nz.put(\\\\\\\"baseDir\\\\\\\", baseDir)\\\\nprint(\\\\\\\"\\\\\\\"\\\\\\\"%html\\\\n<script>\\\\n    var heads = document.getElementsByTagName('h2');\\\\n    var numHeads = heads.length;\\\\n    var inner = \\\\\\\"\\\\\\\";\\\\n    var i = 0;\\\\n    var j = 0;\\\\n    while (i < numHeads){\\\\n        inner = heads[i].innerHTML;\\\\n        if (inner.search(\\\\\\\".-\\\\\\\") != -1 ) {\\\\n            j++;\\\\n            heads[i].innerHTML = inner.replace(/(~|\\\\\\\\d+)\\\\\\\\.-/,\\\\\\\"\\\\\\\"+j+\\\\\\\".-\\\\\\\");\\\\n        }\\\\n        i++\\\\n    }\\\\n</script>\\\\n\\\\\\\"\\\\\\\"\\\\\\\")\\\\n\\\",\\\"config\\\":{\\\"tableHide\\\":true,\\\"editorSetting\\\":{\\\"language\\\":\\\"scala\\\"},\\\"colWidth\\\":12,\\\"editorMode\\\":\\\"ace/mode/scala\\\",\\\"editorHide\\\":true,\\\"fontSize\\\":9,\\\"title\\\":true,\\\"results\\\":{},\\\"enabled\\\":true},\\\"params\\\":{}}]\"},\"principal\":\"admin\",\"ticket\":\"6d788359-f608-4f1e-90de-3326c393025e\",\"roles\":\"[\\\"admin\\\"]\"}\nLinea 274:  WARN [2025-10-01 19:27:40,826] ({FIFO-RemoteInterpreter-spark-shared_process-shared_session-1} NotebookServer.java[onStatusChange]:1963) - Job paragraph_1666384803023_696454822 is finished, status: ERROR, exception: null, result: %text Py4JJavaError: An error occurred while calling o537.fin