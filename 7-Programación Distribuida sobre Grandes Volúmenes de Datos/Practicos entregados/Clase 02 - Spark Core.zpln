 = input.count() - 1 # la primer fila tiene el nombre de las columnas\n\nprint(f\"Total de vuelos: {nTotal}\")\n\nparsed = input \\\n    .map(lambda l: l.split(\",\")) \\\n    .setName(\"parsed_flights\") \\\n    .cache()\n\ncancel = parsed.filter(lambda l: l[21] == \"1\") # Completar\nredir = parsed.filter(lambda l: l[23] == \"1\") # Completar\n\nnCancel = cancel.count()\nnRedir = redir.count()\n\nprint(\"cancelados = {}%\".format(float(nCancel) * 100 / nTotal))\nprint(\"redireccionados = {}%\".format(float(nRedir) * 100 / nTotal)) # Completar\n","user":"admin","dateUpdated":"2025-10-01T22:40:39-0300","progress":0,"config":{"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"colWidth":12,"editorMode":"ace/mode/python","fontSize":14,"editorHide":false,"title":false,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"Total de vuelos: 100000\ncancelados = 1.142%\nredireccionados = 0.16%\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://10.42.0.158:4040/jobs/job?id=47"},{"jobUrl":"http://10.42.0.158:4040/jobs/job?id=48"},{"jobUrl":"http://10.42.0.158:4040/jobs/job?id=49"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757165758539_681845189","id":"20191124-133441_1910745321","dateCreated":"2025-09-06T10:35:58-0300","dateStarted":"2025-10-01T22:40:39-0300","dateFinished":"2025-10-01T22:40:41-0300","status":"FINISHED","focus":false},{"title":"Ejercicio","text":"%md\nLa columna 14 del mismo archivo tiene el tiempo del vuelo en minutos. Calcular el máximo.\n\n#### Ayuda\n\n* Busque en la documentacion de la [API RDD](https://spark.apache.org/docs/3.4.3/api/python/reference/pyspark.html#rdd-apis) una acción para calcular el máximo.\n* Ojo que puede haber valores no definidos.\n","user":"admin","dateUpdated":"2025-10-01T22:40:41-0300","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"editorMode":"ace/mode/markdown","editorHide":true,"fontSize":9,"title":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<p>La columna 14 del mismo archivo tiene el tiempo del vuelo en minutos. Calcular el máximo.</p>\n<h4>Ayuda</h4>\n<ul>\n<li>Busque en la documentacion de la <a href=\"https://spark.apache.org/docs/3.4.3/api/python/reference/pyspark.html#rdd-apis\">API RDD</a> una acción para calcular el máximo.</li>\n<li>Ojo que puede haber valores no definidos.</li>\n</ul>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757165758540_2057280413","id":"20171016-232257_285172371","dateCreated":"2025-09-06T10:35:58-0300","status":"FINISHED","dateFinished":"2025-10-01T22:40:41-0300","dateStarted":"2025-10-01T22:40:41-0300"},{"text":"%pyspark\n\n\n# Filtramos sólo por los números (sin encabezado de columna ni \"NA\")\nmax_time = parsed \\\n    .filter(lambda l: l[13].isnumeric()) \\\n    .map(lambda l: int(l[13])) \\\n    .max()\n    \nprint(\"Tiempo de vuelo máximo (min) =\", max_time)\n","user":"admin","dateUpdated":"2025-10-01T22:40:41-0300","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"python","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"},"colWidth":12,"fontSize":14,"editorHide":false,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"Tiempo de vuelo máximo (min) = 369\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://10.42.0.158:4040/jobs/job?id=50"}],"interpreterSettingId":"spark"}},"progressUpdateInter